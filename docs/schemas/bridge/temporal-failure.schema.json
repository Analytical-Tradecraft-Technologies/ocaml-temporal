{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mfow/ocaml-temporal/docs/schemas/bridge/temporal-failure.schema.json",
  "title": "Temporal failure",
  "description": "Closed Temporal failure information carried by the workflow and activity protocols. The info union covers every failure_info arm of the pinned Core schema plus an absent info.",
  "$ref": "#/$defs/failure",
  "$defs": {
    "payload": {"$ref": "temporal-payload.schema.json"},
    "nonnegativeDuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seconds", "nanoseconds"],
      "properties": {
        "seconds": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "nanoseconds": {"type": "integer", "minimum": 0, "maximum": 999999999}
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message", "source", "stack_trace", "encoded_attributes", "cause", "info"],
      "properties": {
        "message": {"type": "string", "maxLength": 65536},
        "source": {"type": "string", "maxLength": 65536},
        "stack_trace": {"type": "string", "maxLength": 65536},
        "encoded_attributes": {"oneOf": [{"$ref": "#/$defs/payload"}, {"type": "null"}]},
        "cause": {"oneOf": [{"$ref": "#/$defs/failure"}, {"type": "null"}]},
        "info": {"$ref": "#/$defs/info"}
      }
    },
    "info": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "type", "non_retryable", "details"],
          "properties": {
            "kind": {"const": "application"},
            "type": {"type": "string", "maxLength": 65536},
            "non_retryable": {"type": "boolean"},
            "details": {"type": "array", "maxItems": 201326592, "items": {"$ref": "#/$defs/payload"}},
            "category": {"enum": ["unspecified", "benign"]},
            "next_retry_delay": {"oneOf": [{"$ref": "#/$defs/nonnegativeDuration"}, {"type": "null"}]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "details", "identity"],
          "properties": {
            "kind": {"const": "canceled"},
            "details": {"type": "array", "maxItems": 201326592, "items": {"$ref": "#/$defs/payload"}},
            "identity": {"type": "string", "maxLength": 65536}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "identity"],
          "properties": {
            "kind": {"const": "terminated"},
            "identity": {"type": "string", "maxLength": 65536}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "scheduled_event_id", "started_event_id", "identity", "activity_type", "activity_id", "retry_state"],
          "properties": {
            "kind": {"const": "activity"},
            "scheduled_event_id": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
            "started_event_id": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
            "identity": {"type": "string", "maxLength": 65536},
            "activity_type": {"type": "string", "minLength": 1, "maxLength": 65536},
            "activity_id": {"type": "string", "minLength": 1, "maxLength": 65536},
            "retry_state": {"enum": ["unspecified", "in_progress", "non_retryable_failure", "timeout", "maximum_attempts_reached", "retry_policy_not_set", "internal_server_error", "cancel_requested"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "namespace", "workflow_id", "run_id", "workflow_type", "initiated_event_id", "started_event_id", "retry_state"],
          "properties": {
            "kind": {"const": "child_workflow"},
            "namespace": {"type": "string", "minLength": 1, "maxLength": 65536},
            "workflow_id": {"type": "string", "minLength": 1, "maxLength": 65536},
            "run_id": {
              "type": "string",
              "minLength": 0,
              "maxLength": 65536,
              "description": "The concrete child run ID. Core uses an empty string only while cancellation is reported before ChildWorkflowExecutionStarted; the bilateral runtime validator requires started_event_id to be zero in that case."
            },
            "workflow_type": {"type": "string", "minLength": 1, "maxLength": 65536},
            "initiated_event_id": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
            "started_event_id": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
            "retry_state": {"enum": ["unspecified", "in_progress", "non_retryable_failure", "timeout", "maximum_attempts_reached", "retry_policy_not_set", "internal_server_error", "cancel_requested"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "timeout_type", "last_heartbeat_details"],
          "properties": {
            "kind": {"const": "timeout"},
            "timeout_type": {"enum": ["unspecified", "start_to_close", "schedule_to_start", "schedule_to_close", "heartbeat"]},
            "last_heartbeat_details": {"type": "array", "maxItems": 201326592, "items": {"$ref": "#/$defs/payload"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "non_retryable"],
          "properties": {
            "kind": {"const": "server"},
            "non_retryable": {"type": "boolean"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "last_heartbeat_details"],
          "properties": {
            "kind": {"const": "reset_workflow"},
            "last_heartbeat_details": {"type": "array", "maxItems": 201326592, "items": {"$ref": "#/$defs/payload"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "scheduled_event_id", "endpoint", "service", "operation", "operation_id", "operation_token"],
          "properties": {
            "kind": {"const": "nexus_operation"},
            "scheduled_event_id": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
            "endpoint": {"type": "string", "maxLength": 65536},
            "service": {"type": "string", "maxLength": 65536},
            "operation": {"type": "string", "maxLength": 65536},
            "operation_id": {"type": "string", "maxLength": 65536, "description": "Core's deprecated predecessor of operation_token, retained for a lossless round trip."},
            "operation_token": {"type": "string", "maxLength": 65536}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "type", "retry_behavior"],
          "properties": {
            "kind": {"const": "nexus_handler"},
            "type": {"type": "string", "maxLength": 65536},
            "retry_behavior": {"enum": ["unspecified", "retryable", "non_retryable"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "description": "The Core failure carried no failure_info. Prost also decodes a failure_info kind added by a newer server this way.",
          "properties": {
            "kind": {"const": "absent"}
          }
        }
      ]
    }
  }
}
