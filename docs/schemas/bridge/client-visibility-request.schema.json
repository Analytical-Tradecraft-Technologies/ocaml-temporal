{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Analytical-Tradecraft-Technologies/ocaml-temporal/schemas/bridge/client-visibility-request.schema.json",
  "title": "OCaml Temporal visibility request",
  "type": "object",
  "additionalProperties": false,
  "required": ["namespace", "query", "page_size", "next_page_token"],
  "properties": {
    "namespace": { "type": "string", "minLength": 1, "maxLength": 65536 },
    "query": { "type": "string", "maxLength": 65536 },
    "page_size": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "next_page_token": { "type": ["string", "null"], "maxLength": 65536 },
    "rpc_timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60000,
      "description": "Optional caller deadline for this RPC in milliseconds (#499), covering Core's transport retries. It replaces the operation's default budget, bounds only the client call, and never affects the workflow. Omitted means the default."
    }
  }
}
