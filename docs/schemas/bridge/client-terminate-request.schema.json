{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Analytical-Tradecraft-Technologies/ocaml-temporal/blob/master/docs/schemas/bridge/client-terminate-request.schema.json",
  "title": "Workflow termination request",
  "type": "object",
  "additionalProperties": false,
  "required": ["namespace", "workflow_id", "run_id", "reason"],
  "properties": {
    "namespace": { "type": "string", "minLength": 1, "maxLength": 65536 },
    "workflow_id": { "type": "string", "minLength": 1, "maxLength": 65536 },
    "run_id": {"type": "string", "maxLength": 65536, "pattern": "^[^\\u0000]*$", "description": "Exact run ID, or the empty string to select the workflow's current run, which Temporal resolves when it handles the request (#791)."},
    "reason": { "type": "string", "maxLength": 65536 }
  }
}
