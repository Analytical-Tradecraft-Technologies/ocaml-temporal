{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mfow/ocaml-temporal/blob/master/docs/schemas/bridge/worker-config.schema.json",
  "title": "OCaml Temporal Core bridge workflow worker configuration",
  "description": "Private, strict worker configuration sent from the OCaml supervisor to Rust.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "namespace",
    "task_queue",
    "build_id",
    "versioning",
    "max_cached_workflows",
    "max_outstanding_workflow_tasks",
    "max_concurrent_workflow_task_polls",
    "graceful_shutdown_timeout_ms"
  ],
  "properties": {
    "namespace": { "type": "string", "minLength": 1, "description": "Runtime validators enforce the 65536-byte transport ceiling; Core and Server enforce semantic limits." },
    "task_queue": { "type": "string", "minLength": 1, "description": "Runtime validators enforce the 65536-byte transport ceiling; Core and Server enforce semantic limits." },
    "build_id": { "type": "string", "minLength": 1, "description": "Runtime validators enforce the 65536-byte transport ceiling; Core and Server enforce semantic limits." },
    "versioning": {
      "description": "Closed worker-routing mode. In legacy and deployment-based modes, build_id must exactly match the top-level build_id; the OCaml and Rust validators enforce that cross-field invariant.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "none" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "build_id"],
          "properties": {
            "kind": { "const": "legacy_build_id" },
            "build_id": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "deployment_name",
            "build_id",
            "use_worker_versioning",
            "default_versioning_behavior"
          ],
          "properties": {
            "kind": { "const": "deployment_based" },
            "deployment_name": { "type": "string", "minLength": 1 },
            "build_id": { "type": "string", "minLength": 1 },
            "use_worker_versioning": { "type": "boolean" },
            "default_versioning_behavior": {
              "type": ["string", "null"],
              "enum": ["auto_upgrade", "pinned", null]
            }
          }
        }
      ]
    },
    "max_cached_workflows": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "max_outstanding_workflow_tasks": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "max_concurrent_workflow_task_polls": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "graceful_shutdown_timeout_ms": { "type": "integer", "minimum": 0, "maximum": 86400000 },
    "task_types": {
      "description": "Task kinds the worker polls, derived from its registrations (#805). workflows enables workflow polling and in-process local activities; activities enables remote activity polling. At least one must be true. When omitted, both are polled; the OCaml encoder always sends it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["workflows", "activities"],
      "properties": {
        "workflows": { "type": "boolean" },
        "activities": { "type": "boolean" }
      },
      "not": {
        "properties": {
          "workflows": { "const": false },
          "activities": { "const": false }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "max_cached_workflows": { "minimum": 1 }
        }
      },
      "then": {
        "properties": {
          "max_concurrent_workflow_task_polls": { "minimum": 2 }
        }
      }
    }
  ]
}
