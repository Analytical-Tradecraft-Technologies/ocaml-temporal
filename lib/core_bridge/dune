;; Every path in this rule is relative to this dune file, never to Dune's
;; workspace-root variable. When the SDK is vendored (for example under
;; [vendor/temporal] with [(vendored_dirs vendor)]), the workspace root is the
;; consumer's project, which contains neither the bridge scripts nor the Rust
;; sources. Dune runs the action from this directory, so [../..] is always the
;; SDK root, whether it is the workspace itself or a vendored subdirectory.
(rule
 (targets
  libocaml_temporal_core_bridge.a
  dllocaml_temporal_core_bridge%{ext_dll}
  rust_static_link_flags.sexp
  rust_ocaml_link_flags.sexp
  (dir rust-imports))
 (deps
  (env_var TEMPORAL_RUST_BRIDGE_DIR)
  (env_var TEMPORAL_RUST_BRIDGE_KEY)
  (source_tree ../../rust)
  ../../scripts/rust-bridge-artifact.sh
  ../../scripts/copy-rust-bridge-artifacts.sh
  ../../scripts/render-rust-link-flags.sh)
 (action
  ;; Dune's [source_tree] input is copied read-only into the action sandbox.
  ;; Cargo's target directory is mutable, so advertise a writable sibling as a
  ;; fallback for the bridge script. An explicitly configured
  ;; [CARGO_TARGET_DIR] remains authoritative; this fallback must not make the
  ;; Docker or native Makefile workflows build the Rust graph twice. The
  ;; fallback stays inside the SDK's own build directory so a vendored SDK
  ;; never writes Cargo output into the consumer's build root.
  (setenv
   OCAML_TEMPORAL_RUST_TARGET_FALLBACK
   ../../rust-target
   (setenv
    TEMPORAL_OCAML_IMPORT_DIR
    rust-imports
    (setenv
     TEMPORAL_OCAML_LINK_FLAGS
     rust_ocaml_link_flags.sexp
     (run
      sh
      %{dep:../../scripts/build-rust-bridge.sh}
      ../..
      libocaml_temporal_core_bridge.a
      dllocaml_temporal_core_bridge%{ext_dll}
      rust_static_link_flags.sexp))))))

(include install-rust-imports.inc)

(foreign_library
 (archive_name temporal_native_stubs)
 (language c)
 (names native_stubs)
 (include_dirs ../../rust/core-bridge/include)
 (flags :standard -Wall -Wextra))

;; Warnings are fatal only in the development profile used by CI and local
;; builds. [opam install] builds with [-p], which selects the release profile,
;; so a new warning from a user's newer or different C compiler cannot turn
;; installation into a hard failure.
(env
 (dev
  (c_flags
   (:standard -Werror))))

(library
 (name temporal_core_bridge)
 (package temporal-sdk)
 (no_dynlink)
 (modules native_bridge)
 (libraries temporal_base temporal_protocol yojson)
 (foreign_archives temporal_native_stubs ocaml_temporal_core_bridge)
 (library_flags (:include rust_ocaml_link_flags.sexp))
 (c_library_flags
  (:include rust_static_link_flags.sexp)))
