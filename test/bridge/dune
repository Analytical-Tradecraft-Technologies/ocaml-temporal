; Seeded mutation fuzzing of every OCaml protocol decoder and multi-Domain
; close/finalizer/attach races through the C stubs (#506).
;
; These two run under their own aliases, not `runtest`: the multi-Domain
; stress starts several Core runtimes and Tokio pools at once, which starved
; the timing-bound runtime tests on the small Windows runner when Dune ran
; them side by side. `make test` and `make native-test` build
; @test/bridge/bridge-stress only after `dune runtest` has finished; see
; docs/reference/bridge-decoder-fuzz.md.
(executable
 (name test_ocaml_decoder_fuzz)
 (modules test_ocaml_decoder_fuzz)
 (libraries temporal_protocol temporal_core_bridge))

(rule
 (alias decoder-fuzz)
 (deps
  (source_tree fixtures)
  (env_var DECODER_FUZZ_SEED)
  (env_var DECODER_FUZZ_OCAML_CASES)
  (env_var DECODER_FUZZ_TARGET))
 (action
  (run %{exe:test_ocaml_decoder_fuzz.exe})))

(executable
 (name test_ocaml_concurrent_lifecycle_stress)
 (modules test_ocaml_concurrent_lifecycle_stress)
 (libraries temporal_core_bridge))

(rule
 (alias concurrent-stress)
 (deps
  (env_var LIFECYCLE_STRESS_SEED)
  (env_var CONCURRENT_STRESS_OCAML_ROUNDS)
  (env_var CONCURRENT_STRESS_OCAML_DOMAINS))
 (action
  (run %{exe:test_ocaml_concurrent_lifecycle_stress.exe})))

; Both bridge stresses, run after `dune runtest` by the Make test targets.
(alias
 (name bridge-stress)
 (deps
  (alias decoder-fuzz)
  (alias concurrent-stress)))

