 (libraries temporal-sdk temporal_runtime temporal_core_bridge unix))

; Reruns the idle-pacing regressions with the Windows sleep model (sub-ms
; Thread.delay returns at once, longer sleeps last whole 15.625 ms ticks) for
; the fixture's own sleeps, so the interleaving of the Windows x64 CI job is
; exercised on every platform. The lanes' local yields keep using the
; bridge's high-resolution pacing sleep, as they do on Windows (#1008).

(rule
 (alias runtest)
 (action
  (setenv
   IDLE_TEST_SLEEP_MODEL
   windows
   (run %{exe:test_native_worker_idle.exe}))))

; Per-worker Domain budget (#1042). OCAMLRUNPARAM=d=1 leaves the runtime only
; its main Domain, so any Domain the code under test spawned would fail; on
; OCaml 5.2, which ignores the parameter, the exhaustion checks are skipped.

(test
 (name test_worker_domain_budget)
 (modules test_worker_domain_budget)
 (libraries temporal_runtime threads unix)
 (action
  (setenv
   OCAMLRUNPARAM
   d=1
   (run %{test}))))
