; Replay history corpus (issues #518 and #524). The frozen definitions are
; shared by the live capture program and the Docker-free corpus runner so both
; register the exact same application code; see
; docs/reference/history-corpus.md.

(library
 (name temporal_history_corpus_definitions)
 (wrapped false)
 (modules corpus_definitions)
 (libraries temporal-sdk task_failure_support))

; Manifest validation and public Temporal.Replay execution used by the runner.

(library
 (name temporal_history_corpus_runner)
 (wrapped false)
 (modules corpus_sha256 corpus_manifest corpus_runner)
 (libraries temporal-sdk temporal_history_corpus_definitions yojson))

; The gate and upgrade runner. `dune runtest` replays the committed corpus;
; `make test-history-corpus-upgrade` runs the same executable with a JSON
; report and candidate identifiers. Cargo.lock is a dependency so a Core pin
; change always re-runs the corpus.

(test
 (name history_corpus_runner)
 (modules history_corpus_runner)
 (deps
  (source_tree ../fixtures/history-corpus))
 (action
  (run
   %{test}
   %{dep:../fixtures/history-corpus/manifest.json}
   --cargo-lock
   %{dep:../../rust/Cargo.lock}))
 (libraries temporal_history_corpus_runner))

; Negative path: a mutated copy of the corpus must fail with its case IDs.

(test
 (name test_history_corpus_mismatch)
 (modules test_history_corpus_mismatch)
 (deps
  (source_tree ../fixtures/history-corpus))
 (action
  (run
   %{test}
   %{exe:history_corpus_runner.exe}
   %{dep:../fixtures/history-corpus/manifest.json}
   %{dep:../../rust/Cargo.lock}))
 (libraries yojson unix))
