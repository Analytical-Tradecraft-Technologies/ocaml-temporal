; [main] is also linked as bytecode: the documented Dune [(modes byte)]
; consumer must link outside the SDK workspace, which does not inherit its
; [disable_dynamically_linked_foreign_archives] setting (#1020).
(executable
 (name main)
 (modes exe byte)
 (modules main public_api)
 (libraries temporal-sdk))

(executable
 (name worker_environment)
 (modules worker_environment)
 (libraries temporal-sdk))

; Runs Temporal.Replay from the installed package against a history-corpus
; history that the install scripts copy next to this fixture (#497).
(executable
 (name installed_replay)
 (modules installed_replay)
 (libraries temporal-sdk))
