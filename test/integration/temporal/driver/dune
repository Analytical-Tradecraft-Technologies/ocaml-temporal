(executable
 (name smoke_driver)
 (libraries temporal-sdk temporal_two_binary_smoke_common unix))

(executable
 (name restart_driver)
 (libraries temporal-sdk temporal_two_binary_smoke_common unix))

;; This client-only assertion process owns the parent workflow handle while
;; the external controller replaces its dedicated worker between generations.
(executable
 (name parent_child_restart_driver)
 (libraries temporal-sdk temporal_two_binary_smoke_common unix))

(executable
 (name cache_eviction_driver)
 (libraries temporal-sdk temporal_two_binary_smoke_common cache_eviction_wait unix))

;; A standalone client/worker binary lets the live controller replace workers
;; without holding Dune locks or linking another copy of Core for each process.
;; temporal_runtime supplies only the private observer seam that the one-slot
;; cache worker uses to record cache-full evictions and replay activations.
(executable
 (name start_metadata_driver)
 (libraries temporal-sdk temporal_runtime unix))
