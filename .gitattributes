* text=auto

# These files are executed by POSIX shells on Linux, macOS, and the Cygwin
# environment used by Windows CI. Keep their syntax portable at checkout time.
*.sh text eol=lf
Makefile text eol=lf
.gitattributes text eol=lf

# Metadata contract tests compare these build and packaging inputs exactly.
# Keep their checkout representation stable on Windows as well as POSIX hosts.
Dockerfile* text eol=lf
dune-project text eol=lf
*.opam text eol=lf
*.opam.locked text eol=lf
.github/workflows/*.yml text eol=lf

# Bundle manifests and composite actions are also read by native POSIX tools.
.github/actions/*/action.yml text eol=lf
scripts/ci-smoke-executables.txt text eol=lf
scripts/opam-lock-overrides.txt text eol=lf

# Vendored upstream licence texts are verified byte for byte against the
# SHA-256 recorded in their reviewed manifest, so they must not gain CRLF.
scripts/license-texts/** text eol=lf

# Replay corpus histories are verified byte for byte against the SHA-256 in
# their manifest (docs/reference/history-corpus.md); never convert them.
test/fixtures/history-corpus/histories/** -text
test/fixtures/history-corpus/manifest.json text eol=lf
