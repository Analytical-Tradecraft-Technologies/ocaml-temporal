* text=auto

# These files are executed by POSIX shells on Linux, macOS, and the Cygwin
# environment used by Windows CI. Keep their syntax portable at checkout time.
*.sh text eol=lf
Makefile text eol=lf
.gitattributes text eol=lf

# Metadata contract tests compare these build and packaging inputs exactly.
# Keep their checkout representation stable on Windows as well as POSIX hosts.
Dockerfile* text eol=lf
dune-project text eol=lf
*.opam text eol=lf
*.opam.locked text eol=lf
.github/workflows/*.yml text eol=lf
