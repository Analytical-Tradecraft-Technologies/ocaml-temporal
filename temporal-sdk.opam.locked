opam-version: "2.0"
name: "temporal-sdk"
version: "~dev"
synopsis: "Experimental Temporal workflows in modern OCaml"
description: "An experimental typed OCaml 5 workflow SDK backed by Temporal Core"
maintainer: "Michael Fowlie"
authors: "Michael Fowlie"
license: "Apache-2.0"
tags: [ "temporal" "workflow" "sdk" "experimental" ]
x-maintenance-intent: [ "(latest)" ]
homepage: "https://github.com/Analytical-Tradecraft-Technologies/ocaml-temporal"
bug-reports: "https://github.com/Analytical-Tradecraft-Technologies/ocaml-temporal/issues"
depends: [
  "base-bigarray" {= "base"}
  "base-domains" {= "base"}
  "base-nnp" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "dune" {= "3.24.0"}
  "logs" {= "0.10.0"}
  "ocaml" {= "5.2.1"}
  "ocaml-base-compiler" {= "5.2.1"}
  "ocaml-config" {= "3"}
  "ocaml-options-vanilla" {= "1"}
  "ocamlbuild" {= "0.16.1"}
  "ocamlfind" {= "1.9.8"}
  "topkg" {= "1.1.1"}
  "yojson" {= "3.0.0"}
]
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" name "-j" jobs]
]
run-test: ["dune" "runtest" "-p" name "-j" jobs]
dev-repo: "git+https://github.com/Analytical-Tradecraft-Technologies/ocaml-temporal.git"
pin-depends: [
  "ocaml-base-compiler.5.2.1"
  "https://github.com/ocaml/ocaml/releases/download/5.2.1/ocaml-5.2.1.tar.gz"
]
