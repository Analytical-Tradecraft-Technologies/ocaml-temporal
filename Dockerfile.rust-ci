# Match Dockerfile.dev's Rust toolchain and Debian 12 C-library baseline.
# Native amd64/arm64 runners build this image without cross compilation.
FROM rust:1.100-bookworm@sha256:ade39a710ef85f3506cffcfec3e8a24ba090badef1dff2fb798f71d878833fea
# rust/rust-toolchain.toml is the single Rust version pin, so this base image
# only supplies rustup and Debian 12. Installing the pinned channel (a no-op
# when the base already ships it) and removing any other toolchain means a
# Rust bump needs no image bump, and the image's rustc is always the one
# test/smoke/test_rust_toolchain.sh expects.
COPY rust/rust-toolchain.toml scripts/rust-version.sh /tmp/rust-version/
RUN rust_version="$(sh /tmp/rust-version/rust-version.sh /tmp/rust-version/rust-toolchain.toml)" \
    && rustup toolchain install "$rust_version" --profile minimal --component clippy --component rustfmt \
    && rustup default "$rust_version" \
    && for toolchain in $(rustup toolchain list | awk '{ print $1 }'); do \
        case "$toolchain" in "$rust_version"-*) ;; *) rustup toolchain uninstall "$toolchain" ;; esac; \
    done \
    && rm -rf /tmp/rust-version
RUN apt-get update \
    && apt-get install -y --no-install-recommends libprotobuf-dev protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*
ENV CARGO_HOME=/workspace/_build/cargo-home \
    CARGO_TARGET_DIR=/workspace/_build/rust \
    CARGO_INCREMENTAL=0 \
    CARGO_PROFILE_DEV_DEBUG=line-tables-only \
    CARGO_PROFILE_TEST_DEBUG=line-tables-only
WORKDIR /workspace

# Make supplies a fresh value on every invocation, so cached toolchains and
# dependencies remain reusable while runtime Cargo/opam HTTPS uses current roots.
ARG CA_CERTIFICATES_REFRESH
RUN test -n "${CA_CERTIFICATES_REFRESH}" \
    && apt-get -o Acquire::Retries=3 update \
    && apt-get -o Acquire::Retries=3 install --reinstall --no-install-recommends -y ca-certificates \
    && update-ca-certificates --fresh \
    && rm -rf /var/lib/apt/lists/*
