ARG RUST_IMAGE=rust:1.99-bookworm@sha256:e12566d5abc17a0da741628782cdb504b68b8961f5bfcf677936bf3e8b32de29
# The digest-pinned ocaml/opam base image for one supported compiler series.
# Each series pins its image on the single FROM line of
# docker/ocaml-<series>/Dockerfile, which is the only source of truth; the
# Makefile resolves OCAML_VERSION to that reference with scripts/ocaml-image.sh
# and passes it here. The pins live outside this file so Dependabot can track
# each series' tag on its own and refresh only its digest (#1027). There is
# deliberately no default: a build without OCAML_IMAGE fails instead of
# silently using an unpinned or wrong-series image. An explicit image
# reference is still accepted for local experiments, but CI and release lanes
# only pass the pinned references.
ARG OCAML_IMAGE

FROM ${RUST_IMAGE} AS rust-toolchain
RUN rustup component add clippy rustfmt

FROM ${OCAML_IMAGE} AS dev-base

USER root
# Retry transient package downloads without retrying the build or test suite.
RUN apt-get -o Acquire::Retries=3 update \
    && apt-get -o Acquire::Retries=3 install --no-install-recommends -y \
        libprotobuf-dev \
        protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

COPY --from=rust-toolchain /usr/local/cargo /usr/local/cargo
COPY --from=rust-toolchain /usr/local/rustup /usr/local/rustup

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/workspace/_build/cargo-home \
    CARGO_TARGET_DIR=/workspace/_build/rust \
    PATH=/usr/local/cargo/bin:${PATH}

USER opam
WORKDIR /workspace
COPY --chown=opam:opam temporal-sdk.opam temporal-sdk.opam.locked dune-project ./
COPY --chown=opam:opam scripts/opam-locked-deps.sh scripts/opam-lock-overrides.txt ./scripts/
# Install the exact locked closure (minus the image-owned compiler packages)
# and fail the image build if any installed version differs from the lock.
RUN opam repository set-url default https://opam.ocaml.org \
    && opam update \
    && sh scripts/opam-locked-deps.sh install --no-depexts

CMD ["opam", "exec", "--", "dune", "build"]

# CI-only API documentation tooling for `make docs`. odoc and its closure are
# installed at the exact versions in scripts/docs-tools.locked on top of the
# locked SDK closure, which is re-checked so the documentation tool cannot
# silently move an SDK dependency. The set of packages the install adds must
# equal the manifest exactly: opam also installs transitive dependencies, so an
# unlisted package (a manifest omission or new upstream metadata) fails the
# build instead of slipping past the licence review. Nothing in this stage is linked into or
# shipped with the SDK; see docs/reference/quality-gates.md.
FROM dev-base AS docs
COPY --chown=opam:opam scripts/docs-tools.locked ./scripts/
RUN set -eu; \
    tools=$(sed -e 's/#.*//' -e '/^[[:space:]]*$/d' scripts/docs-tools.locked); \
    installed() { opam list --installed --short --columns=name,version \
        | awk '{ print $1 " " $2 }' | LC_ALL=C sort; }; \
    installed > /tmp/docs-before; \
    opam install --yes --no-depexts $(printf '%s\n' "$tools" | awk '{ print $1 "." $2 }'); \
    installed > /tmp/docs-after; \
    LC_ALL=C comm -13 /tmp/docs-before /tmp/docs-after > /tmp/docs-added; \
    printf '%s\n' "$tools" | awk '{ print $1 " " $2 }' | LC_ALL=C sort > /tmp/docs-expected; \
    if ! cmp -s /tmp/docs-added /tmp/docs-expected; then \
        echo "docs tool closure differs from scripts/docs-tools.locked" >&2; \
        echo "(< installed by opam, > listed in the manifest):" >&2; \
        diff /tmp/docs-added /tmp/docs-expected >&2 || true; \
        exit 1; \
    fi; \
    rm -f /tmp/docs-before /tmp/docs-after /tmp/docs-added /tmp/docs-expected; \
    sh scripts/opam-locked-deps.sh check

USER root
# Make supplies a fresh value on every invocation, so cached toolchains and
# dependencies remain reusable while runtime Cargo/opam HTTPS uses current roots.
ARG CA_CERTIFICATES_REFRESH
RUN test -n "${CA_CERTIFICATES_REFRESH}" \
    && apt-get -o Acquire::Retries=3 update \
    && apt-get -o Acquire::Retries=3 install --reinstall --no-install-recommends -y ca-certificates \
    && update-ca-certificates --fresh \
    && rm -rf /var/lib/apt/lists/*
USER opam

# The default (last) stage stays the ordinary development image, so builds
# that do not request the `docs` target never install the documentation tools.
FROM dev-base AS dev

USER root
# Make supplies a fresh value on every invocation, so cached toolchains and
# dependencies remain reusable while runtime Cargo/opam HTTPS uses current roots.
ARG CA_CERTIFICATES_REFRESH
RUN test -n "${CA_CERTIFICATES_REFRESH}" \
    && apt-get -o Acquire::Retries=3 update \
    && apt-get -o Acquire::Retries=3 install --reinstall --no-install-recommends -y ca-certificates \
    && update-ca-certificates --fresh \
    && rm -rf /var/lib/apt/lists/*
USER opam
