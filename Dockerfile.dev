ARG RUST_IMAGE=rust:1.99-bookworm@sha256:e12566d5abc17a0da741628782cdb504b68b8961f5bfcf677936bf3e8b32de29
# The digest-pinned ocaml/opam base image for one supported compiler series.
# Each series pins its image on the single FROM line of
# docker/ocaml-<series>/Dockerfile, which is the only source of truth; the
# Makefile resolves OCAML_VERSION to that reference with scripts/ocaml-image.sh
# and passes it here. The pins live outside this file so Dependabot can track
# each series' tag on its own and refresh only its digest (#1027). There is
# deliberately no default: a build without OCAML_IMAGE fails instead of
# silently using an unpinned or wrong-series image. An explicit image
# reference is still accepted for local experiments, but CI and release lanes
# only pass the pinned references.
ARG OCAML_IMAGE

FROM ${RUST_IMAGE} AS rust-toolchain
# rust/rust-toolchain.toml is the single Rust version pin, so this base image
# only supplies rustup and Debian 12. Installing the pinned channel (a no-op
# when the base already ships it) and removing any other toolchain means a
# Rust bump needs no image bump, and the image's rustc is always the one
# test/smoke/test_rust_toolchain.sh expects.
COPY rust/rust-toolchain.toml scripts/rust-version.sh /tmp/rust-version/
RUN rust_version="$(sh /tmp/rust-version/rust-version.sh /tmp/rust-version/rust-toolchain.toml)" \
    && rustup toolchain install "$rust_version" --profile minimal --component clippy --component rustfmt \
    && rustup default "$rust_version" \
    && for toolchain in $(rustup toolchain list | awk '{ print $1 }'); do \
        case "$toolchain" in "$rust_version"-*) ;; *) rustup toolchain uninstall "$toolchain" ;; esac; \
    done \
    && rm -rf /tmp/rust-version

FROM ${OCAML_IMAGE} AS dev-base

USER root
# Retry transient package downloads without retrying the build or test suite.
# lld links the live-test executables only (scripts/build-temporal-executables.sh);
# SDK tests and the install consumer keep the default GNU linker.
RUN apt-get -o Acquire::Retries=3 update \
    && apt-get -o Acquire::Retries=3 install --no-install-recommends -y \
        libprotobuf-dev \
        lld \
        protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

COPY --from=rust-toolchain /usr/local/cargo /usr/local/cargo
COPY --from=rust-toolchain /usr/local/rustup /usr/local/rustup

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/workspace/_build/cargo-home \
    CARGO_TARGET_DIR=/workspace/_build/rust \
    PATH=/usr/local/cargo/bin:${PATH}

USER opam
WORKDIR /workspace
COPY --chown=opam:opam temporal-sdk.opam temporal-sdk.opam.locked dune-project ./
COPY --chown=opam:opam scripts/opam-locked-deps.sh scripts/opam-lock-overrides.txt ./scripts/
# Install the exact locked closure (minus the image-owned compiler packages)
# and fail the image build if any installed version differs from the lock.
RUN opam repository set-url default https://opam.ocaml.org \
    && opam update \
    && sh scripts/opam-locked-deps.sh install --no-depexts

CMD ["opam", "exec", "--", "dune", "build"]

# CI-only API documentation tooling for `make docs`. odoc and its closure are
# installed at the exact versions in scripts/docs-tools.locked on top of the
# locked SDK closure. scripts/opam-tool-lock.sh requires the set of packages
# the install adds to equal the manifest exactly (opam also installs transitive
# dependencies, so an unlisted package fails the build instead of slipping past
# the licence review) and then re-checks the SDK closure, so the documentation
# tool cannot silently move an SDK dependency. Nothing in this stage is linked
# into or shipped with the SDK; see docs/reference/quality-gates.md.
FROM dev-base AS docs
COPY --chown=opam:opam scripts/docs-tools.locked scripts/opam-tool-lock.sh ./scripts/
RUN sh scripts/opam-tool-lock.sh install scripts/docs-tools.locked --no-depexts

USER root
# Make supplies a fresh value on every invocation, so cached toolchains and
# dependencies remain reusable while runtime Cargo/opam HTTPS uses current roots.
ARG CA_CERTIFICATES_REFRESH
RUN test -n "${CA_CERTIFICATES_REFRESH}" \
    && apt-get -o Acquire::Retries=3 update \
    && apt-get -o Acquire::Retries=3 install --reinstall --no-install-recommends -y ca-certificates \
    && update-ca-certificates --fresh \
    && rm -rf /var/lib/apt/lists/*
USER opam

# CI-only dependencies of the Eio integration example (examples/eio, #1141):
# eio, eio_posix and their closure at the exact versions in
# scripts/eio-example.locked, installed and checked like the documentation
# tools above. They are dependencies of that one example executable only,
# never of the SDK, and `make license-check` audits every entry; see
# docs/dependencies.md. TEMPORAL_EIO_EXAMPLE enables examples/eio/dune, which
# every other image and build skips.
FROM dev-base AS examples-eio
COPY --chown=opam:opam scripts/eio-example.locked scripts/opam-tool-lock.sh ./scripts/
RUN sh scripts/opam-tool-lock.sh install scripts/eio-example.locked --no-depexts
ENV TEMPORAL_EIO_EXAMPLE=enabled

USER root
# Make supplies a fresh value on every invocation, so cached toolchains and
# dependencies remain reusable while runtime Cargo/opam HTTPS uses current roots.
ARG CA_CERTIFICATES_REFRESH
RUN test -n "${CA_CERTIFICATES_REFRESH}" \
    && apt-get -o Acquire::Retries=3 update \
    && apt-get -o Acquire::Retries=3 install --reinstall --no-install-recommends -y ca-certificates \
    && update-ca-certificates --fresh \
    && rm -rf /var/lib/apt/lists/*
USER opam

# The default (last) stage stays the ordinary development image, so builds
# that do not request the `docs` or `examples-eio` target never install the
# documentation tools or the Eio example's dependencies.
FROM dev-base AS dev

USER root
# Make supplies a fresh value on every invocation, so cached toolchains and
# dependencies remain reusable while runtime Cargo/opam HTTPS uses current roots.
ARG CA_CERTIFICATES_REFRESH
RUN test -n "${CA_CERTIFICATES_REFRESH}" \
    && apt-get -o Acquire::Retries=3 update \
    && apt-get -o Acquire::Retries=3 install --reinstall --no-install-recommends -y ca-certificates \
    && update-ca-certificates --fresh \
    && rm -rf /var/lib/apt/lists/*
USER opam
